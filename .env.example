# ── Desarrollo local sin Docker ──────────────────────────────────────────
# Copia este archivo a .env.local. `npm run dev` lo lee directamente.

DATABASE_URL="postgres://hematopass:hematopass@localhost:5432/hematopass"
# En Windows, si 5432 falla por el rango dinámico de Hyper-V, publica
# Postgres en otro puerto de host (ej. 55432:5432 en docker-compose.yml)
# y ajusta esta URL para que coincida.

# Genera uno con: npx auth secret   (o: openssl rand -base64 33)
AUTH_SECRET="reemplaza-esto-con-un-valor-generado"
AUTH_TRUST_HOST="true"

NEXT_PUBLIC_APP_NAME="Hematopass"

# Umbrales del motor de riesgo (docs/plan-desarrollo.md §4). Configurables a
# propósito: cuando el mentor clínico del INSNSB corrija un umbral, se
# cambia aquí sin tocar código.
RISK_R1_DIAS_SIN_ACTIVIDAD="28"
RISK_R2_HORAS_VENCIDO="48"
RISK_R4_HORAS_RESULTADO_HUERFANO="72"
RISK_R5_HORAS_VIAJE="48"

# ── Solo Docker Compose ──────────────────────────────────────────────────
# Copia este archivo a .env (sin sufijo) en la raíz para `docker compose up`.
# Compose arma DATABASE_URL desde estas tres variables — no dupliques el
# valor de arriba dentro de Docker.

# Debe coincidir con el usuario/contraseña de DATABASE_URL arriba si además
# corres `npm run dev` local contra el mismo Postgres de Docker — Postgres
# solo aplica esta contraseña la PRIMERA vez que inicializa su volumen; si
# la cambias después, hay que borrar el volumen (`docker compose down -v`)
# para que se vuelva a aplicar.
POSTGRES_USER="hematopass"
POSTGRES_PASSWORD="hematopass"
POSTGRES_DB="hematopass"

# ":80" sirve HTTP plano (IP directa / localhost). Con un dominio real,
# Caddy emite y renueva TLS solo: SITE_ADDRESS="hematopass.tudominio.org"
SITE_ADDRESS=":80"
